# ==============================================================================
# Medicare Hospital Management System - Environment Configuration
# ==============================================================================
# Copy or rename this file to '.env' in your local environment,
# or set these variables in your Vercel Project Settings > Environment Variables.

# --- Core Django Settings ---
DJANGO_SECRET_KEY=your-strong-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.vercel.app,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Production Database (PostgreSQL / Neon / Supabase / Railway) ---
# If left empty, SQLite is used locally. On Vercel, supply an external PostgreSQL URL.
DATABASE_URL=

# --- Gmail SMTP Notification Configuration ---
# 1. EMAIL_HOST_USER: Your full Gmail address (e.g., yourgmail@gmail.com)
# 2. EMAIL_HOST_PASSWORD: 16-character Google App Password (without spaces)
#    Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Hospital Admin Notification Email ---
# Where booking and order alerts for hospital staff are dispatched
HOSPITAL_ADMIN_EMAIL=
DEFAULT_FROM_EMAIL=Medicare Hospital <noreply@medicare.local>
