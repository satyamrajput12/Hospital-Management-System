# ==============================================================================
# Medicare Healthcare Management System - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the .env file with production secrets to version control.

# Security
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration (Defaults to SQLite; uncomment for PostgreSQL/MySQL)
# DATABASE_URL=sqlite:///db.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=medicare_db
# DB_USER=medicare_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration
# Default development backend prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Medicare Hospital" <noreply@medicare.local>
# For SMTP production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password

# Security / HTTPS settings (set to True in production with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
